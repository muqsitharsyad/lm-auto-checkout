{
  "name": "lm-auto-checkout",
  "version": "1.0.0",
  "description": "Logam Mulia automated checkout with Telegram VA notifications",
  "main": "dist/interfaces/cli/index.js",
  "scripts": {
    "dev": "ts-node src/interfaces/cli/index.ts",
    "dev:login": "ts-node src/interfaces/cli/login.ts",
    "dev:checkout": "ts-node src/interfaces/cli/checkout.ts",
    "dev:http-checkout": "ts-node src/interfaces/cli/http-checkout.ts",
    "build": "tsc",
