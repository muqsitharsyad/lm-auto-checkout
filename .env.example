# ═══════════════════════════════════════════════════════════════════════════
# Logam Mulia Auto-Checkout Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Login credentials (required for checkout)
LM_EMAIL=your-email@example.com
LM_PASSWORD=your-password

# Target gramasi to checkout (comma-separated, empty = all available)
# Example: 0.5,1,2,3,5,10,25,50,100
TARGET_WEIGHTS=0.5,1,2,3

# Telegram configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Webhook server port (receives checkout triggers from stock-scheduler)
WEBHOOK_PORT=3300

# Session refresh interval in seconds (default: 5 minutes)
SESSION_REFRESH_INTERVAL=300

# Headless mode (true for server, false for local debugging)
HEADLESS=true

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Save screenshot and HTML on error for debugging
DEBUG_SCREENSHOT_ON_ERROR=true

# Wit.ai token for automated reCAPTCHA audio bypass (recommended for server)
# Without this, captcha solving requires manual intervention
WIT_AI_ACCESS_TOKEN=

# Cooldown after successful checkout in seconds (prevents multiple orders)
# Default: 1 hour = 3600 seconds
CHECKOUT_COOLDOWN_SECONDS=3600
